<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ניהול מלאי רימונים</title>
  <!-- Tailwind CSS לקבלת עיצוב מודרני ומהיר -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Firebase SDKs -->
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
  <style>
    body { background-color: #0b132b; color: #ffffff; font-family: system-ui, -apple-system, sans-serif; }
    .card { background-color: #1c2541; border: 1px solid #2a385b; }
    .btn-primary { background-color: #3a506b; hover:background-color: #486581; }
  </style>
</head>
<body class="p-4 max-w-3xl mx-auto pb-12">

  <!-- כותרת ראשית -->
  <header class="text-center mb-6 border-b border-gray-700 pb-4">
    <h1 class="text-2xl font-bold text-blue-400">ניהול מלאי רימונים</h1>
    <p class="text-xs text-gray-400 mt-1">מסונכרן בזמן אמת (Firebase) - כל מכשיר רואה ומעדכן</p>
    
    <!-- ניווט בין מסכים -->
    <div class="flex justify-center gap-4 mt-4">
      <button onclick="switchTab('dashboard')" class="bg-blue-600 px-4 py-2 rounded-lg font-bold text-sm">דו"ח מרוכז</button>
      <button onclick="switchTab('teams')" class="bg-gray-700 px-4 py-2 rounded-lg font-bold text-sm">צוותים</button>
    </div>
  </header>

  <!-- מסך 1: דו"ח מרוכז -->
  <div id="tab-dashboard">
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="card p-4 rounded-xl text-center">
        <span class="text-gray-400 text-xs block mb-1">סך רימונים מאופסים</span>
        <span id="stat-zeroed" class="text-3xl font-extrabold text-green-400">0</span>
      </div>
      <div class="card p-4 rounded-xl text-center">
        <span class="text-gray-400 text-xs block mb-1">סך רימונים רשומים</span>
        <span id="stat-total" class="text-3xl font-extrabold text-blue-400">0</span>
      </div>
    </div>

    <div class="card p-4 rounded-xl">
      <h2 class="text-sm font-bold mb-3 border-b border-gray-700 pb-2">כמות מאופסת לכל מספר סדרה לפי צוותים</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
          <thead>
            <tr class="border-b border-gray-600 text-gray-400">
              <th class="p-2">מספר סדרה</th>
              <th class="p-2">חפ"ק</th>
              <th class="p-2">חוד</th>
              <th class="p-2">פיקודית</th>
              <th class="p-2">רותק</th>
            </tr>
          </thead>
          <tbody id="matrix-body">
            <!-- נתונים יוזרמו לכאן אוטומטית -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- מסך 2: רשימת צוותים -->
  <div id="tab-teams" class="hidden">
    <div class="flex gap-2 mb-4">
      <input type="text" id="new-team-name" placeholder="שם צוות חדש..." class="bg-gray-800 border border-gray-700 rounded-lg p-2 text-sm flex-1">
      <button onclick="addTeam()" class="bg-blue-600 px-4 py-2 rounded-lg text-sm font-bold">+</button>
    </div>

    <div id="teams-list" class="space-y-3">
      <!-- רשימת הצוותים תוצג כאן -->
    </div>
  </div>

  <!-- מסך 3: ניהול צוות ספציפי -->
  <div id="tab-single-team" class="hidden">
    <button onclick="switchTab('teams')" class="text-xs text-blue-400 mb-3 block">← חזרה לכל הצוותים</button>
    <h2 id="current-team-title" class="text-xl font-bold mb-4 border-b border-gray-700 pb-2"></h2>

    <div class="card p-4 rounded-xl mb-4">
      <h3 class="text-sm font-bold mb-2">הוספת חייל</h3>
      <div class="flex gap-2">
        <input type="text" id="new-soldier-name" placeholder="שם החייל" class="bg-gray-800 border border-gray-700 rounded-lg p-2 text-sm flex-1">
        <button onclick="addSoldier()" class="bg-green-600 px-4 py-2 rounded-lg text-sm font-bold">הוסף</button>
      </div>
    </div>

    <div id="soldiers-list" class="space-y-4">
      <!-- חיילים ורימונים יוזנו כאן -->
    </div>
  </div>

  <script>
    // הגדרות Firebase - יש להחליף את ה-Config הזה בפרטים מהפרויקט שלך ב-Firebase
    const firebaseConfig = {
      apiKey: "YOUR_API_KEY",
      authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
      databaseURL: "https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com",
      projectId: "YOUR_PROJECT_ID",
      storageBucket: "YOUR_PROJECT_ID.appspot.com",
      messagingSenderId: "YOUR_SENDER_ID",
      appId: "YOUR_APP_ID"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    let currentTeamId = null;

    // ניווט בלשוניות
    function switchTab(tabName) {
      document.getElementById('tab-dashboard').classList.add('hidden');
      document.getElementById('tab-teams').classList.add('hidden');
      document.getElementById('tab-single-team').classList.add('hidden');

      document.getElementById(`tab-${tabName}`).classList.remove('hidden');
    }

    // סנכרון נתונים בזמן אמת מול Firebase
    db.ref('inventory').on('value', (snapshot) => {
      const data = snapshot.val() || {};
      renderDashboard(data);
      renderTeams(data);
      if (currentTeamId) renderSingleTeam(data, currentTeamId);
    });

    // הוספת צוות
    function addTeam() {
      const name = document.getElementById('new-team-name').value.trim();
      if (!name) return;
      const teamId = db.ref('inventory').push().key;
      db.ref(`inventory/${teamId}`).set({ name: name, soldiers: {} });
      document.getElementById('new-team-name').value = '';
    }

    // הוספת חייל
    function addSoldier() {
      const name = document.getElementById('new-soldier-name').value.trim();
      if (!name || !currentTeamId) return;
      const soldierId = db.ref(`inventory/${currentTeamId}/soldiers`).push().key;
      db.ref(`inventory/${currentTeamId}/soldiers/${soldierId}`).set({
        name: name,
        grenades: [{ id: 1, serial: '', number: '', isZeroed: false }]
      });
      document.getElementById('new-soldier-name').value = '';
    }

    // הוספת רימון לחייל
    function addGrenade(soldierId, currentGrenades = []) {
      const updated = [...currentGrenades, { id: Date.now(), serial: '', number: '', isZeroed: false }];
      db.ref(`inventory/${currentTeamId}/soldiers/${soldierId}/grenades`).set(updated);
    }

    // עדכון פרטי רימון
    function updateGrenade(soldierId, gIndex, field, value) {
      db.ref(`inventory/${currentTeamId}/soldiers/${soldierId}/grenades/${gIndex}/${field}`).set(value);
    }

    // הצגת רשימת צוותים
    function renderTeams(data) {
      const list = document.getElementById('teams-list');
      list.innerHTML = '';
      Object.keys(data).forEach(teamId => {
        const team = data[teamId];
        const soldiers = team.soldiers ? Object.values(team.soldiers) : [];
        let totalZeroed = 0;
        soldiers.forEach(s => {
          (s.grenades || []).forEach(g => { if (g.isZeroed) totalZeroed++; });
        });

        list.innerHTML += `
          <div class="card p-4 rounded-xl flex justify-between items-center">
            <div>
              <h3 class="font-bold text-lg">${team.name}</h3>
              <p class="text-xs text-gray-400">${soldiers.length} חיילים · ${totalZeroed} רימונים מאופסים</p>
            </div>
            <button onclick="openTeam('${teamId}')" class="bg-blue-600 px-3 py-1.5 rounded-lg text-xs font-bold">כניסה לצוות</button>
          </div>
        `;
      });
    }

    // פתיחת צוות ספציפי
    function openTeam(teamId) {
      currentTeamId = teamId;
      switchTab('single-team');
      db.ref('inventory').once('value', snapshot => {
        renderSingleTeam(snapshot.val(), teamId);
      });
    }

    // הצגת חיילי צוות
    function renderSingleTeam(data, teamId) {
      const team = data[teamId];
      if (!team) return;
      document.getElementById('current-team-title').innerText = team.name;

      const list = document.getElementById('soldiers-list');
      list.innerHTML = '';

      const soldiers = team.soldiers || {};
      Object.keys(soldiers).forEach(sId => {
        const soldier = soldiers[sId];
        const grenades = soldier.grenades || [];

        let grenadesHTML = grenades.map((g, idx) => `
          <div class="bg-gray-800 p-2 rounded-lg mt-2 border border-gray-700 text-xs space-y-2">
            <div class="flex gap-2">
              <input type="text" placeholder="סדרה (למשל 4-21)" value="${g.serial || ''}" 
                onchange="updateGrenade('${sId}', ${idx}, 'serial', this.value)" class="bg-gray-900 p-1.5 rounded border border-gray-700 w-1/2">
              <input type="text" placeholder="מס' רימון" value="${g.number || ''}" 
                onchange="updateGrenade('${sId}', ${idx}, 'number', this.value)" class="bg-gray-900 p-1.5 rounded border border-gray-700 w-1/2">
            </div>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" ${g.isZeroed ? 'checked' : ''} 
                onchange="updateGrenade('${sId}', ${idx}, 'isZeroed', this.checked)" class="w-4 h-4 text-blue-600 rounded">
              <span>מאופס</span>
            </label>
          </div>
        `).join('');

        list.innerHTML += `
          <div class="card p-3 rounded-xl">
            <h4 class="font-bold text-sm mb-1">${soldier.name}</h4>
            ${grenadesHTML}
            <button onclick='addGrenade("${sId}", ${JSON.stringify(grenades)})' class="w-full mt-2 bg-gray-700 hover:bg-gray-600 text-xs py-1.5 rounded-lg">+ הוסף רימון</button>
          </div>
        `;
      });
    }

    // חישוב ועדכון ה-Dashboard
    function renderDashboard(data) {
      let total = 0;
      let zeroed = 0;
      let seriesMap = {}; // { "4-21": { "צוות א": 2 } }

      Object.values(data).forEach(team => {
        if (!team.soldiers) return;
        Object.values(team.soldiers).forEach(s => {
          (s.grenades || []).forEach(g => {
            if (g.serial) {
              total++;
              if (g.isZeroed) {
                zeroed++;
                if (!seriesMap[g.serial]) seriesMap[g.serial] = {};
                seriesMap[g.serial][team.name] = (seriesMap[g.serial][team.name] || 0) + 1;
              }
            }
          });
        });
      });

      document.getElementById('stat-total').innerText = total;
      document.getElementById('stat-zeroed').innerText = zeroed;

      // טבלה
      const tbody = document.getElementById('matrix-body');
      tbody.innerHTML = '';
      Object.keys(seriesMap).forEach(serial => {
        tbody.innerHTML += `
          <tr class="border-b border-gray-700">
            <td class="p-2 font-bold">${serial}</td>
            <td class="p-2">${seriesMap[serial]['חפ"ק'] || '-'}</td>
            <td class="p-2">${seriesMap[serial]['חוד'] || '-'}</td>
            <td class="p-2">${seriesMap[serial]['פיקודית'] || '-'}</td>
            <td class="p-2">${seriesMap[serial]['רותק'] || '-'}</td>
          </tr>
        `;
      });
    }
  </script>
</body>
</html>
